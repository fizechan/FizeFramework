{
  "name": "fize/framework",
  "description": "FizeFramework，一个轻巧、自由、灵活的MVC框架。",
  "license": "MIT",
  "authors": [
    {
      "name": "FizeChan",
      "email": "chenfengzhan@qq.com"
    }
  ],
  "autoload": {
    "files": [
      "app/common/constants.php",
      "app/common/functions.php"
    ],
    "psr-4": {
      "Fize\\Framework\\": "src"
    }
  },
  "provide": {
    "psr/container-implementation": "1.0.0"
  },
  "require": {
    "php": ">=7.2.0",
    "fize/cache": "*",
    "fize/database": "*",
    "fize/exception": "*",
    "fize/io": "*",
    "fize/log": "*",
    "fize/security": "*",
    "fize/session": "*",
    "fize/view": "*",
    "fize/web": "*",
    "psr/container": "^1.1"
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "demo/app/",
      "Tests\\": "tests"
    }
  },
  "require-dev": {
    "guzzlehttp/guzzle": "*",
    "phpunit/phpunit": "^9.6.38",
    "twig/twig": "*"
  }
}
